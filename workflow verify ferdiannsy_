name: Verify Human Identity ferdiannsy_

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'Nama agent kamu'
        required: true
        default: 'Ferdiannsy_'
      agent_description:
        description: 'Deskripsi singkat agent'
        required: true
        default: 'Ferdiannsy_ AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '20'

      - name: Step 1 - Install ClawHub skill
        run: npx clawhub@latest install verified-agent-identity

      - name: Install script dependencies
        run: |
          cd scripts
          npm install

      - name: Step 2 - Create new Ethereum Identity
        run: node scripts/createNewEthereumIdentity.js --key <0x6a8f442dca47d566e056b08e0801aad0c1faa5248002204cda2f980e1af542b2>

      - name: Step 3 - Link Human to Agent
        run: |
          node scripts/manualLinkHumanToAgent.js --challenge '{"name": "Ferdiannsy_", "description": "Ferdiannsy_ AI Agent"}'
